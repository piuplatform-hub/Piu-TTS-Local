# ==============================================================================
# AI Voice Studio — Environment Configuration Template
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true

# Server Network Binding (Localhost ONLY for Phase 1)
HOST=127.0.0.1
PORT=8765

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Paths
# Configurable persistent data root (Survives code updates)
# Default proposed location: D:\AIVoiceStudioData
STUDIO_DATA_DIR=D:\AIVoiceStudioData

# Database
# Defaults to SQLite in WAL mode inside STUDIO_DATA_DIR
DATABASE_URL=sqlite+aiosqlite:///D:/AIVoiceStudioData/studio.db

# Hardware / Worker Configuration
MAX_CONCURRENT_CPU_JOBS=1
ENABLE_GPU_INFERENCE=false
