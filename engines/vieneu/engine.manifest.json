{
  "manifest_version": "1.0",
  "engine_id": "vieneu-tts",
  "name": "VieNeu-TTS v3 Turbo",
  "version": "3.8.3",
  "author": "pnnbao97 / OpenMOSS Team",
  "license": "Apache-2.0",
  "description": "High-quality neural Vietnamese speech synthesis and voice cloning using PyTorch CUDA when available, with ONNX Runtime FP32 CPU fallback",
  "capabilities": [
    "text_to_speech",
    "voice_cloning",
    "speaker_selection",
    "advanced_voice_controls"
  ],
  "supported_languages": [
    "vi"
  ],
  "default_sample_rate": 48000,
  "runtime": {
    "entrypoint": "engines/vieneu/worker.py",
    "python_version_min": "3.10",
    "python_version_max": "3.12",
    "virtualenv_path": "D:/AIVoiceStudioData/benchmarks/envs/vieneu_env"
  },
  "hardware_profile": {
    "supported_devices": [
      "cpu",
      "gpu"
    ],
    "default_device": "auto",
    "estimated_vram_mb": 0,
    "estimated_ram_mb": 2048
  },
  "parameters_schema": {
    "speed": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 2.0,
      "default": 1.0,
      "description": "Speech rate multiplier (DSP time-stretch, pitch-preserving)"
    },
    "ref_audio": {
      "type": "string",
      "description": "Optional path to reference WAV audio for zero-shot voice cloning"
    },
    "denoise": {
      "type": "boolean",
      "default": true,
      "description": "Denoise reference audio before extracting speaker embedding"
    },
    "temperature": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1.5,
      "default": 0.8,
      "description": "Sampling temperature for vocal variety and expressiveness"
    },
    "top_p": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1.0,
      "default": 0.95,
      "description": "Nucleus sampling probability threshold"
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 25,
      "description": "Top-K filtering limit for token generation"
    },
    "repetition_penalty": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 2.5,
      "default": 1.2,
      "description": "Repetition penalty factor to prevent syllable stuttering"
    },
    "repetition_window": {
      "type": "integer",
      "minimum": 10,
      "maximum": 200,
      "default": 50,
      "description": "Token window size for repetition penalty"
    }
  }
}
